flowchart TB
    APP["<b>Tidemark</b><br/>one app, on the iPhone"]

    subgraph FREE["Free: the whole core"]
        direction LR
        F1["<b>Today and Trend</b><br/>trend, pace, history,<br/>why the scale jumped"]
        F2["<b>Your plan</b><br/>goal, breaks, holding<br/>at your goal"]
        F3["<b>Up to 3 habits</b><br/>and your waist"]
        F4["<b>Medication log</b><br/>doses and reminders"]
        F5["<b>Apple Health, widgets,<br/>reminders, Face ID, backups</b>"]
    end

    subgraph PLUS["Tidemark Plus: £2.99 a month, £19.99 a year or £49.99 once"]
        direction LR
        P1["<b>Your trend at each dose</b><br/>and side effects"]
        P2["<b>A report</b><br/>for your doctor"]
        P3["<b>Photos and more<br/>measurements</b>"]
        P4["<b>Calorie estimate,<br/>protein target</b>"]
        P5["<b>Up to 6 habits,<br/>protected backups</b>"]
    end

    subgraph NEXT["Not built yet"]
        direction LR
        N1["<b>iCloud sync</b>"]
        N2["<b>Apple Watch</b>"]
    end

    APP --> FREE
    APP --> PLUS
    APP -.-> NEXT

    classDef core fill:#2A1E45,stroke:#FF6B5E,stroke-width:3px,color:#FBF7F3
    classDef live fill:#E4F7EF,stroke:#12B886,stroke-width:2px,color:#241B33
    classDef dev fill:#FFF3D8,stroke:#D9701F,stroke-width:2px,stroke-dasharray:6 4,color:#241B33
    classDef ext fill:#F0E8E0,stroke:#8F8276,stroke-width:1.5px,color:#241B33
    class APP core
    class F1,F2,F3,F4,F5,P1,P2,P3,P4,P5 live
    class N1,N2 dev
